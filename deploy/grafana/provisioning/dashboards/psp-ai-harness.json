{
  "uid": "psp-ai-harness",
  "title": "PSP AI Harness",
  "tags": ["genai", "psp"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Duração do harness — p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Operações por status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(gen_ai_client_operation_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens por tipo (input / output)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m]))",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Custo estimado (USD, acumulado por operação)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(psp_ai_cost_USD_sum[5m]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Invocações de tool",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_tool_name, success) (rate(psp_ai_tool_invocations_total[5m]))",
          "legendFormat": "{{gen_ai_tool_name}} success={{success}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Negações de authz — SINAL DE SEGURANÇA",
      "description": "Pico = assinatura de prompt injection barrado na camada 2 (Authorize). Traces correspondentes são retidos a 100% pelo tail sampling.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_tool_name) (rate(psp_ai_authz_denials_total[5m]))",
          "legendFormat": "{{gen_ai_tool_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Operações em voo",
      "description": "Sobe e não desce = chamadas penduradas no provider (timeout mal configurado).",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(psp_ai_operations_active)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Iterações do ReAct — p95 (proxy de qualidade)",
      "description": "Pico na distribuição de iterações é o alerta mais próximo de degradação de qualidade que existe.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(psp_ai_iterations_bucket[5m])))",
          "legendFormat": "p95 iterações"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Collector — saúde do pipeline",
      "description": "dropped_too_early = decision_wait curto; send_failed = backpressure; refused = memory_limiter atuando.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(otelcol_processor_tail_sampling_sampling_trace_dropped_too_early[5m])",
          "legendFormat": "dropped_too_early"
        },
        {
          "refId": "B",
          "expr": "rate(otelcol_exporter_send_failed_spans[5m])",
          "legendFormat": "send_failed_spans"
        },
        {
          "refId": "C",
          "expr": "rate(otelcol_processor_refused_spans[5m])",
          "legendFormat": "refused_spans"
        }
      ]
    }
  ]
}
