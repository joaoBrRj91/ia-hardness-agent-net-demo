{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Anthropic": {
    "ApiKey": ""
  },

  "AllowedTenants": [ "tenant-demo", "acme", "globex" ],

  "RateLimit": {
    "ToolCallsPerMinute": 30
  },

  "Otel": {
    "Endpoint": "http://localhost:4317"
  },

  "AI": {
    "Telemetry": {
      "RecordContent": false,
      "MaxContentLength": 2000,
      "DefaultModel": "claude-sonnet-4-6",
      "CostAlertThresholdUsd": 0.50,
      "Pricing": {
        "claude-sonnet-4-6":         { "InputPerMillion": 0.0, "OutputPerMillion": 0.0 },
        "claude-haiku-4-5-20251001": { "InputPerMillion": 0.0, "OutputPerMillion": 0.0 }
      }
    }
  }
}
